# ==== SENSITIVE DATA — never commit ====
# Environment files (only the examples are shareable)
.env
.env.*
!.env.example
.env.local
.env.*.local

# ASP.NET secrets: real keys belong to `dotnet user-secrets` (stored at
# %APPDATA%\Microsoft\UserSecrets\<UserSecretsId>\secrets.json, outside the repo)
secrets.json
appsettings.Secrets.json
appsettings.*.Secrets.json
appsettings.*.local.json
appsettings.Production.json
# IDE run profiles often stash env-var secrets — keep local
backend/src/InterviewDrill.Api/Properties/launchSettings.json

